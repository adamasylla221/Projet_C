    void genererNumVente(char *buffer, size_t size) {
        time_t now = time(NULL);
        struct tm *t = localtime(&now);
        snprintf(buffer, size, "%04d%02d%02d%02d%02d%02d",
            t->tm_year + 1900, t->tm_mon +1, t->tm_mday, t->tm_hour, t->tm_min, t->tm_sec);
